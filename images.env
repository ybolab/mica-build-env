# The inputs of the build-env images: the base images they build from, pinned by
# digest, and every toolchain they install, pinned by version and source hash.
# Not a release asset: a release carries the build-env-image.lock
# publish-images.sh generates. Change a value, run `bash build.sh`, read what it says.
#
# Sourced, not parsed: keep to plain assignments. Pin the multi-arch index digest,
# not a per-architecture one. To bump a pin, set the digest or hash to PENDING and
# run `bash build.sh`; it prints the value to record and fails.
#
# Naming -- the prefix before the first underscore is the image, and build.sh
# filters each image's lock by it:
#   IMAGE_<distro>_<release>   an upstream base image, `name:tag@sha256:...`
#   <IMAGE>_FLOOR_<tool>_MIN   the minimum version a mica-build-<image> asserts
#   <IMAGE>_<tool>_VERSION     a toolchain archive's version
#   <IMAGE>_<tool>_URL_<arch>  where that archive is fetched from
#   <IMAGE>_<tool>_SHA256_<arch>  its source hash

# The Debian every image builds from.
IMAGE_DEBIAN_TRIXIE=debian:trixie-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132

# The `# syntax=` frontend; written out in every Dockerfile and checked by build.sh.
IMAGE_DOCKERFILE_FRONTEND=docker/dockerfile:1@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32

# mica-build-base: the common floor. Floors are minimums because the digest does
# not pin the apt archive; raise one only when trixie has actually moved.
BASE_FLOOR_CODENAME=trixie
BASE_FLOOR_GIT_MIN=2.47
BASE_FLOOR_FILE_MIN=5.46
BASE_FLOOR_BINUTILS_MIN=2.44
BASE_FLOOR_XZ_MIN=5.8
BASE_FLOOR_MMDEBSTRAP_MIN=1.5

# bun, from the upstream release zip. The version must stay above the URLs that read it.
BASE_BUN_VERSION=1.4.2
BASE_BUN_URL_AMD64=https://github.com/oven-sh/bun/releases/download/bun-v${BASE_BUN_VERSION}/bun-linux-x64.zip
BASE_BUN_URL_ARM64=https://github.com/oven-sh/bun/releases/download/bun-v${BASE_BUN_VERSION}/bun-linux-aarch64.zip
BASE_BUN_SHA256_AMD64=36368faef7527875d5ffa52e53cd48021741f2a83eb6208a8dd64068d422a913
BASE_BUN_SHA256_ARM64=54328bbc2d9c8e0c9f892c544d66c57a83b84139e34909e5ee81758f1ac8fda7

# The local tags build.sh builds the published images under before
# publish-images.sh pushes them. Not IMAGE_ keys: they have no digest, and no
# row lists the LOCAL_ prefix, so they reach no lock. No tag: build.sh and
# from.sh append `:<arch>`.
LOCAL_MICA_BUILD_BASE=localhost/mica-build-base
LOCAL_MICA_BUILD_C=localhost/mica-build-c
LOCAL_MICA_BUILD_GO=localhost/mica-build-go
LOCAL_MICA_BUILD_RUST=localhost/mica-build-rust

# mica-build-c: floors, from the unpinned apt archive. autoconf, automake,
# libtoolize and python3 are presence-only.
C_FLOOR_GCC_MIN=14.2
C_FLOOR_MAKE_MIN=4.4
C_FLOOR_CMAKE_MIN=3.31
C_FLOOR_PKGCONF_MIN=1.8
C_FLOOR_CCACHE_MIN=4.11

# mica-build-go: the latest patch of the mature major line. Go cross-compiles
# without an extra pin.
GO_VERSION=1.26.7
GO_URL_AMD64=https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz
GO_URL_ARM64=https://go.dev/dl/go${GO_VERSION}.linux-arm64.tar.gz
GO_SHA256_AMD64=ffb5f8de10c62550dfddab66b36b57030721e0a44a3218e9e1181d7b59f121ca
GO_SHA256_ARM64=5a4ec883379d51ee9ce1040d5e87f8d35e20387574dd8c947feb01eabc3c1b37

# mica-build-rust: current stable. RUST_STD_* is the std for the other
# architecture, which the host tarball does not carry.
RUST_VERSION=1.98.0
RUST_TRIPLE_AMD64=x86_64-unknown-linux-gnu
RUST_TRIPLE_ARM64=aarch64-unknown-linux-gnu
RUST_URL_AMD64=https://static.rust-lang.org/dist/rust-${RUST_VERSION}-${RUST_TRIPLE_AMD64}.tar.xz
RUST_URL_ARM64=https://static.rust-lang.org/dist/rust-${RUST_VERSION}-${RUST_TRIPLE_ARM64}.tar.xz
RUST_SHA256_AMD64=ed8ee2df70909c88cbaf87a6cfa3920dac00b537de12a6abe6906641e0f5952f
RUST_SHA256_ARM64=ac9283184301aeed06ecc9f5aa4c1be7041e18a1b197b6cb6c5d162d98f566da
RUST_STD_URL_AMD64=https://static.rust-lang.org/dist/rust-std-${RUST_VERSION}-${RUST_TRIPLE_AMD64}.tar.xz
RUST_STD_URL_ARM64=https://static.rust-lang.org/dist/rust-std-${RUST_VERSION}-${RUST_TRIPLE_ARM64}.tar.xz
RUST_STD_SHA256_AMD64=f5022e6c95a5ad23cca2513dc8281200f585fa188de6370aa37b128a43f876a3
RUST_STD_SHA256_ARM64=a36f7ac98af20ef0ba6368aace0345efabbebaef7962eba99f47190fd256162d

# The Rust gate tools in mica-build-rust: clippy and rustfmt come from
# RUST_SHA256_*; nextest and deny are pinned here and also read by CI. musl
# builds are static.
# cargo-deny stays on 0.19.x to match the deny.toml schema.
RUSTCHECK_NEXTEST_VERSION=0.9.143
RUSTCHECK_NEXTEST_URL_AMD64=https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-${RUSTCHECK_NEXTEST_VERSION}/cargo-nextest-${RUSTCHECK_NEXTEST_VERSION}-x86_64-unknown-linux-musl.tar.gz
RUSTCHECK_NEXTEST_URL_ARM64=https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-${RUSTCHECK_NEXTEST_VERSION}/cargo-nextest-${RUSTCHECK_NEXTEST_VERSION}-aarch64-unknown-linux-musl.tar.gz
RUSTCHECK_NEXTEST_SHA256_AMD64=6d891c18105ec2d33f6e441a4f92b7ccab47ba263e22055c8bb66884243f3389
RUSTCHECK_NEXTEST_SHA256_ARM64=0560ce0ce017f368c54b5db86588370fc03b470985490fa81200e62a657dda05
RUSTCHECK_DENY_VERSION=0.19.9
RUSTCHECK_DENY_URL_AMD64=https://github.com/EmbarkStudios/cargo-deny/releases/download/${RUSTCHECK_DENY_VERSION}/cargo-deny-${RUSTCHECK_DENY_VERSION}-x86_64-unknown-linux-musl.tar.gz
RUSTCHECK_DENY_URL_ARM64=https://github.com/EmbarkStudios/cargo-deny/releases/download/${RUSTCHECK_DENY_VERSION}/cargo-deny-${RUSTCHECK_DENY_VERSION}-aarch64-unknown-linux-musl.tar.gz
RUSTCHECK_DENY_SHA256_AMD64=f1f8eedc2a3ac297c540873f93785d4104b102c0079506b2a6b3221b7ec956af
RUSTCHECK_DENY_SHA256_ARM64=32580dcc2bc13fbeeb7c50edc38ef99c3b9ce9569a1d07a96e11b3b941f3e72e

# mica-build-base, Debian packaging: floors. dpkg and dpkg-dev are floored
# separately because they come from different packages; perl because the
# dpkg-dev tools are perl.
DEB_FLOOR_DPKG_MIN=1.22
DEB_FLOOR_DPKG_DEV_MIN=1.22
DEB_FLOOR_PERL_MIN=5.40

# mica-build-base, openssl and jq: floors. openssl mints the fleet's trust
# material, so the image also records its exact version.
OPENSSL_FLOOR_OPENSSL_MIN=3.5
OPENSSL_FLOOR_JQ_MIN=1.7
